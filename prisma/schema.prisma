// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  name            String?
  role            Role     @default(MAINTAINER)
  githubId        String?  @unique
  githubUsername  String?  @unique
  githubTokenCiphertext String?
  githubTokenUpdatedAt  DateTime?
  leetcodeUsername String?
  location        String?
  bio             String?
  avatar          String?
  joinedAt        DateTime @default(now())
  lastActive      DateTime @default(now())
  
  // Relations
  events          EventAttendee[]
  activities      Activity[]
  githubStats     GitHubStats?
  leetcodeStats   LeetCodeStats?
  createdEvents   Event[]   @relation("EventCreator")
  reviewedEvents  Event[]   @relation("EventApprover")
  
  @@map("users")
  @@index([joinedAt])
  @@index([lastActive])
  @@index([role, joinedAt])
}

model Event {
  id              String      @id @default(cuid())
  title           String
  description     String
  date            DateTime
  location        String
  maxAttendees    Int
  type            EventType
  status          EventStatus @default(UPCOMING)
  approvalStatus  ApprovalStatus @default(PENDING)
  rejectionReason String?
  /// The full write-up, in the same shape as the public event pages. See src/types/events.ts.
  details         Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  /// Who decided this proposal and when, whichever way they decided. (Stored in the old approvedAt/approvedById columns.)
  reviewedAt      DateTime? @map("approvedAt")
  reviewedById    String?   @map("approvedById")
  
  // Relations
  creatorId       String
  creator         User            @relation("EventCreator", fields: [creatorId], references: [id])
  reviewedBy      User?           @relation("EventApprover", fields: [reviewedById], references: [id])
  attendees       EventAttendee[]
  activities      Activity[]
  
  @@map("events")
  @@index([approvalStatus, date])
  @@index([approvalStatus, createdAt])
  @@index([creatorId, createdAt])
}

model EventAttendee {
  id       String   @id @default(cuid())
  userId   String
  eventId  String
  joinedAt DateTime @default(now())
  
  // Relations
  user     User  @relation(fields: [userId], references: [id])
  event    Event @relation(fields: [eventId], references: [id])
  
  @@unique([userId, eventId])
  @@map("event_attendees")
  @@index([userId])
  @@index([eventId])
  @@index([eventId, joinedAt])
}

model GitHubStats {
  id            String   @id @default(cuid())
  userId        String   @unique
  commits       Int      @default(0)
  pullRequests  Int      @default(0)
  issues        Int      @default(0)
  repositories  Int      @default(0)
  followers     Int      @default(0)
  contributions Int      @default(0)
  languages     Json?    // Store as JSON: {"JavaScript": 45, "TypeScript": 30}
  contributionCalendar Json?
  lastSynced    DateTime @default(now())
  
  // Relations
  user          User @relation(fields: [userId], references: [id])
  
  @@map("github_stats")
  @@index([lastSynced])
  @@index([contributions])
  @@index([commits])
}

model LeetCodeStats {
  id                String   @id @default(cuid())
  userId            String   @unique
  leetcodeUsername  String
  totalSolved       Int      @default(0)
  easySolved        Int      @default(0)
  mediumSolved      Int      @default(0)
  hardSolved        Int      @default(0)
  ranking           Int?
  reputation        Int      @default(0)
  acceptanceRate    Float?
  lastSynced        DateTime @default(now())
  
  // Relations
  user              User @relation(fields: [userId], references: [id])
  
  @@map("leetcode_stats")
  @@index([lastSynced])
  @@index([totalSolved])
}

model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  userId      String
  description String
  metadata    Json?        // Store additional data as JSON
  sourceKey   String?      @unique
  createdAt   DateTime     @default(now())
  
  eventId     String?
  
  // Relations
  user        User     @relation(fields: [userId], references: [id])
  event       Event?   @relation(fields: [eventId], references: [id])
  
  @@map("activities")
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([createdAt, id])
  @@index([type, createdAt])
}

// Enums
enum Role {
  ADMIN
  MAINTAINER
}

enum EventType {
  WORKSHOP
  HACKATHON
  MEETUP
  CONFERENCE
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum ActivityType {
  COMMIT
  PULL_REQUEST
  ISSUE
  EVENT_JOIN
  EVENT_CREATE
  MEMBER_JOIN
  EVENT_PROPOSAL
  EVENT_APPROVED
  EVENT_REJECTED
  LEETCODE_EASY
  LEETCODE_MEDIUM
  LEETCODE_HARD
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
